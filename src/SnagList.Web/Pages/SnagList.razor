@page "/"
@using global::SnagList.Contracts.Snags
@using global::SnagList.Domain.Snags
@using global::SnagList.Web.Services
@inject SnagListApiClient Api

<h1 class="mb-4">Snags</h1>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <select class="form-select w-auto" @onchange="OnStatusChanged">
        <option value="">All statuses</option>
        @foreach (var status in Enum.GetValues<SnagStatus>())
        {
            <option value="@status">@status</option>
        }
    </select>
    <a class="btn btn-primary" href="/snags/report">Report a Snag</a>
</div>

@if (snags is null)
{
    <p class="text-muted">Loading…</p>
}
else if (snags.Count == 0)
{
    <p class="empty-state">No Snags found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white">
            <thead>
                <tr><th>Sub-location</th><th>Category</th><th>Severity</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var snag in snags)
                {
                    <tr>
                        <td>@snag.SubLocation</td>
                        <td>@snag.Category</td>
                        <td><span class="badge @BadgeStyles.ForSeverity(snag.Severity)">@snag.Severity</span></td>
                        <td><span class="badge @BadgeStyles.ForStatus(snag.Status)">@snag.Status</span></td>
                        <td class="text-end"><a href="/snags/@snag.Id">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (nextCursor is not null)
    {
        <button id="load-more" class="btn btn-outline-secondary" @onclick="LoadMore">Load more</button>
    }
}

@code {
    private List<SnagSummaryResponse> snags = null!;
    private string? nextCursor;
    private SnagStatus? filterStatus;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        filterStatus = string.IsNullOrEmpty(e.Value?.ToString())
            ? null
            : Enum.Parse<SnagStatus>(e.Value!.ToString()!);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var page = await Api.ListSnagsAsync(new SnagListFilter(Status: filterStatus, Limit: 20), CancellationToken.None);
        snags = page.Items.ToList();
        nextCursor = page.NextCursor;
    }

    private async Task LoadMore()
    {
        var page = await Api.ListSnagsAsync(new SnagListFilter(Status: filterStatus, Cursor: nextCursor, Limit: 20), CancellationToken.None);
        snags.AddRange(page.Items);
        nextCursor = page.NextCursor;
    }
}
